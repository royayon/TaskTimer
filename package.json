{
  "name": "tasktimer",
  "version": "1.0.4",
  "description": "Cross-platform iPhone-inspired multi-timer with Windows taskbar & macOS menu bar/dock integration, mini-window, and lockscreen persistence",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icons": "python scripts/create_icons.py",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist": "electron-builder -w"
  },
  "build": {
    "appId": "com.royayon.tasktimer",
    "productName": "TaskTimer",
    "copyright": "Copyright © 2026 royayon",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TaskTimer"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "title": "TaskTimer Installer",
      "icon": "build/icon.png"
    }
  },
  "keywords": [
    "timer",
    "taskbar",
    "electron",
    "ios-style",
    "multitimer",
    "lockscreen"
  ],
  "author": "royayon",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.4.0"
  }
}
